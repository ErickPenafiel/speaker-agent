# Local (docker compose). Para Neon: postgresql+asyncpg://user:pass@host/db?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/speaker_agent
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/speaker_agent_test
VAPI_WEBHOOK_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:5173
TIMEZONE=America/La_Paz
CURRENCY=BOB

# Proveedor de voz activo: vapi | retell (las rutas de ambos están siempre montadas)
VOICE_PROVIDER=vapi
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
RETELL_API_KEY=
RETELL_AGENT_ID=

# Límites (formato slowapi) y retención
RATE_LIMIT_PANEL=120/minute
RATE_LIMIT_WRITE=30/minute
RATE_LIMIT_WEB_CALL=5/minute;30/hour
WEB_CALL_DAILY_CAP=200
DATA_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=6

# Base de datos (Neon): pega la URL tal cual la da Neon; se convierte sola para asyncpg.
#   DATABASE_URL        -> endpoint pooled (-pooler) para la app
#   DATABASE_URL_DIRECT -> endpoint directo, solo para migraciones
DATABASE_URL_DIRECT=
# DB_POOLED=true   # forzar modo pooler en pgbouncers que no llevan "-pooler" en el host

# Observabilidad
ENVIRONMENT=development       # development | production
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json (producción: json)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
RELEASE=

# SOLO DESARROLLO: guarda los payloads de Vapi/Retell para crear fixtures (contienen datos personales)
CAPTURE_PAYLOADS_DIR=

# Arranque del contenedor (ver scripts/start.sh)
RUN_MIGRATIONS=0
SEED_ON_START=0
